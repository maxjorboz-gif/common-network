{
  "name": "Orden",
  "type": "object",
  "properties": {
    "numero_orden": {
      "type": "string",
      "description": "N\u00famero de orden legible (ej: PARRI-1025)"
    },
    "id_cliente": {
      "type": "string",
      "description": "Referencia al Cliente (usado para recuperar email_hash y ph_hash)"
    },
    "id_comercio": {
      "type": "string",
      "description": "Referencia al comercio - OBLIGATORIO"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id_producto": {
            "type": "string",
            "description": "SKU taller interno (content_ids)"
          },
          "titulo": {
            "type": "string"
          },
          "imagen": {
            "type": "string"
          },
          "precio_unitario": {
            "type": "number",
            "description": "Precio final cobrado por unidad"
          },
          "cantidad": {
            "type": "number"
          },
          "atributos": {
            "type": "object",
            "description": "Ej: {parrilla: 'acero inox'}"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "descuento": {
      "type": "number",
      "default": 0
    },
    "costo_envio": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "description": "VALOR FINAL: Este es el 'value' que se env\u00eda a Meta CAPI"
    },
    "moneda": {
      "type": "string",
      "default": "ARS",
      "description": "C\u00f3digo de moneda ISO requerido por Meta"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente_pago",
        "pago_confirmado",
        "en_preparacion",
        "enviado",
        "entregado",
        "cancelado"
      ],
      "default": "pendiente_pago"
    },
    "metodo_pago": {
      "type": "string",
      "enum": [
        "transferencia",
        "efectivo",
        "mercadopago",
        "tarjeta"
      ],
      "description": "Clave para determinar si el total enviado incluye recargo o descuento"
    },
    "datos_envio": {
      "type": "object",
      "properties": {
        "nombre": {
          "type": "string"
        },
        "direccion": {
          "type": "string"
        },
        "ciudad": {
          "type": "string"
        },
        "codigo_postal": {
          "type": "string"
        },
        "telefono_normalizado": {
          "type": "string",
          "description": "Tel\u00e9fono pasado por normalizeArgentinaPhone antes de guardarse"
        }
      }
    },
    "fbp": {
      "type": "string",
      "description": "Facebook Browser ID - Debe persistir desde el inicio de la sesi\u00f3n"
    },
    "fbc": {
      "type": "string",
      "description": "Facebook Click ID - Debe persistir desde el clic en el anuncio"
    },
    "evento_purchase_enviado": {
      "type": "boolean",
      "default": false,
      "description": "Flag para evitar que un mismo pedido sume dos veces en Meta"
    },
    "event_id_meta": {
      "type": "string",
      "description": "ID \u00daNICO: Debe generarse igual para Pixel y CAPI (numero_orden + timestamp)"
    },
    "fecha_pago_confirmado": {
      "type": "string",
      "format": "date-time"
    },
    "comision_plataforma": {
      "type": "number"
    },
    "margen_vendedor": {
      "type": "number"
    }
  },
  "required": [
    "id_comercio",
    "items",
    "total",
    "numero_orden",
    "event_id_meta"
  ]
}