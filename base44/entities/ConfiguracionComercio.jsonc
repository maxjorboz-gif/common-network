{
  "name": "ConfiguracionComercio",
  "type": "object",
  "properties": {
    "id_comercio": {
      "type": "string"
    },
    "colores": {
      "type": "object",
      "properties": {
        "primario": {
          "type": "string",
          "default": "#3b82f6"
        },
        "secundario": {
          "type": "string",
          "default": "#1e40af"
        },
        "acento": {
          "type": "string",
          "default": "#f59e0b"
        }
      }
    },
    "whatsapp_alertas_stock": {
      "type": "string",
      "description": "WhatsApp para alertas de stock bajo"
    },
    "whatsapp_alertas_ventas": {
      "type": "string",
      "description": "WhatsApp para nuevas ventas"
    },
    "habilitar_referidos": {
      "type": "boolean",
      "default": true
    },
    "porcentaje_cupon_referido": {
      "type": "number",
      "default": 10
    },
    "habilitar_popup_salida": {
      "type": "boolean",
      "default": true
    },
    "texto_popup_salida": {
      "type": "string",
      "default": "\u00a1Espera! No te vayas sin tu descuento exclusivo"
    },
    "envio_gratis_minimo": {
      "type": "number",
      "default": 0,
      "description": "M\u00ednimo para env\u00edo gratis, 0 = deshabilitado"
    },
    "habilitar_envio_gratis_global": {
      "type": "boolean",
      "default": false,
      "description": "Mostrar cartel 'Env\u00edo Gratis' en todos los productos"
    },
    "costo_envio_default": {
      "type": "number",
      "default": 0
    },
    "datos_transferencia": {
      "type": "object",
      "properties": {
        "banco": {
          "type": "string"
        },
        "cbu": {
          "type": "string"
        },
        "alias": {
          "type": "string"
        },
        "titular": {
          "type": "string"
        }
      }
    },
    "mostrar_stock": {
      "type": "boolean",
      "default": true
    },
    "umbral_escasez": {
      "type": "number",
      "default": 5,
      "description": "Stock para mostrar alerta de escasez"
    },
    "descuento_base_transferencia": {
      "type": "number",
      "default": 10,
      "description": "Descuento base (%) para pagos por transferencia"
    }
  },
  "required": [
    "id_comercio"
  ]
}